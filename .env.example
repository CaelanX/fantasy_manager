# ---- ESPN (redraft league) ----
ESPN_LEAGUE_ID=123456
# Season year as ESPN labels it: the 2026-27 season is 2027. Leave blank to auto-detect.
ESPN_YEAR=
# Private leagues need both cookies. In a browser logged in to fantasy.espn.com:
# DevTools > Application > Cookies > espn.com -> copy espn_s2 and SWID (SWID includes the braces).
ESPN_S2=
ESPN_SWID=
# Optional: your fantasy team id or a substring of its name. If blank, matched via SWID.
ESPN_TEAM=

# ---- Fantrax (dynasty league) ----
FANTRAX_LEAGUE_ID=abcdef1234567890
# Recommended: your Fantrax login. fm logs in itself, saves the session to
# $FM_DATA_DIR/fantrax_session.json and logs in again when it expires. The password is read only
# from this local .env file and is never printed or logged. (Not usable with two-factor login.)
FANTRAX_USERNAME=
FANTRAX_PASSWORD=
# Alternative / fallback: paste the Cookie request header from a logged-in fantrax.com request
# (DevTools > Network > any fxpa/req request > Request Headers > Cookie) ...
FANTRAX_COOKIE=
# ... or point to a file containing that header string / Netscape cookies.txt export.
FANTRAX_COOKIE_FILE=
# Optional: your team id or a substring of its name.
FANTRAX_TEAM=
# Scoring weights are read from the league's Rules page automatically; this is the fallback if that fails.
# Format: stat=points, comma separated; prefix goalie-only values with goalie. (e.g. goalie.G=20).
FANTRAX_POINTS=G=4,A=2,SOG=0.5,PPP=1,SHG=2,HIT=0.3,BLK=0.5,PIM=0.5,W=5,SV=0.25,GA=-1,SO=7.5,goalie.G=20,goalie.A=3
FANTRAX_DYNASTY=true
FANTRAX_KEEPER_HORIZON_YEARS=3
# Dynasty priority: contend (win this season first), balanced (default), or rebuild.
# The dashboard's Mode toggle and `fm mode <mode>` save a choice in <FM_DATA_DIR>/prefs.json
# that overrides this; `fm mode --clear` goes back to this value.
FANTRAX_MODE=balanced

# ---- LLM (optional; heuristics work without it) ----
OPENROUTER_API_KEY=
FM_LLM_MODEL=poolside/laguna-s-2.1:free
# Comma-separated fallbacks tried in order when the primary model fails or is rate-limited.
FM_LLM_FALLBACKS=cohere/north-mini-code:free,nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,qwen/qwen3.8-27b:free
# Only free models are allowed unless this is set to 1 (paid models will be refused otherwise).
FM_LLM_ALLOW_PAID=0

# ---- Betting odds (optional; logged as weekly context, see `fm harness odds`) ----
# Free key from https://the-odds-api.com (500 credits/month). fm makes at most one 2-credit call a
# day (h2h + totals, one region) and archives it to $FM_DATA_DIR/archive/odds-YYYY-MM-DD.json.
ODDS_API_KEY=
# Bookmaker region: us, us2, uk, eu or au (each extra region costs credits; keep one).
ODDS_REGION=us

# ---- Notifications (optional) ----
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# ---- Web dashboard (fm web, or the hosted server in docs/hosting.md) ----
# Login password for the dashboard. Leave it empty on your own PC: without it the dashboard only
# answers on this machine (127.0.0.1). REQUIRED before exposing the dashboard to any network; use a
# long random passphrase (e.g. the output of: openssl rand -base64 24).
FM_WEB_PASSWORD=
# Optional: session-cookie signing key. Default: a random key kept in <FM_DATA_DIR>/web_secret.
FM_WEB_SECRET=
# How many days a login lasts.
FM_WEB_SESSION_DAYS=30
# 1 = allow `fm web --host 0.0.0.0` WITHOUT a password (trusted home network only).
FM_WEB_ALLOW_INSECURE=0

# ---- Runtime ----
# Where the sqlite cache and crosswalk live.
FM_DATA_DIR=./data
# 1 = never hit the network; serve only from cache (useful for tests / offline).
FM_OFFLINE=0
